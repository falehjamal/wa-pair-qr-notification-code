# Server Configuration
PORT=3000
HOST=0.0.0.0

# API Keys (comma-separated, leave empty to disable auth)
API_KEYS=your-api-key-1,your-api-key-2

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Sessions directory
SESSIONS_DIR=./sessions

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
